# Database
DATABASE_URL=postgresql://user:password@host/database

# Facebook
FB_ACCESS_TOKEN=your_facebook_token
FB_PAGE_ID=your_page_id

# LLM APIs (au moins 1 requis)
GROQ_API_KEY=your_groq_key
GEMINI_API_KEY=your_gemini_key

# Image APIs (optionnels)
UNSPLASH_ACCESS_KEY=your_unsplash_key
PEXELS_API_KEY=your_pexels_key

# Auto-engagement (optionnel)
AUTO_LIKE=true           # Active le like automatique
AUTO_COMMENT=true        # Active le commentaire automatique
ENGAGEMENT_DELAY=5       # Délai avant engagement (secondes)

# Config
PUBLICATION_HOUR=14
PUBLICATION_MINUTE=0
TIMEZONE=Indian/Antananarivo        # Fuseau horaire (UTC+3)

ENVIRONMENT=production